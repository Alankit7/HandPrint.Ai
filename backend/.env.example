# ── Handprint AI — backend/.env.example ──────────────────────────────────────
# Copy to backend/.env for running uvicorn directly (without Docker).
# When using Docker, the root .env.example is used instead.

# ── Auth (required) ──────────────────────────────────────────────────────────
API_KEY=changeme-generate-a-real-key

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/db/handprint.db
UPLOAD_DIR=data/uploads
SAMPLE_DIR=data/samples
OUTPUT_DIR=data/outputs

# ── File size limits ──────────────────────────────────────────────────────────
MAX_SAMPLE_IMAGE_MB=10
MAX_PDF_MB=50

# ── Sample constraints ────────────────────────────────────────────────────────
MIN_SAMPLE_IMAGES=15
MAX_SAMPLE_IMAGES=30

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_THREADS=2

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_AGE_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FORMAT=text
LOG_LEVEL=INFO
