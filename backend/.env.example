# ── Copy to .env and fill in real values ─────────────────────────────────────

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Secret API key clients must send in X-API-Key header
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme-generate-a-real-key

# SQLite database URL  (absolute path recommended in production)
DATABASE_URL=sqlite:///./data/db/handprint.db

# Storage directories
UPLOAD_DIR=data/uploads
SAMPLE_DIR=data/samples
OUTPUT_DIR=data/outputs

# File size limits (MB)
MAX_SAMPLE_IMAGE_MB=10
MAX_PDF_MB=50

# Sample image constraints
MIN_SAMPLE_IMAGES=15
MAX_SAMPLE_IMAGES=30

# Worker thread pool size
WORKER_THREADS=2

# Cleanup: delete files older than this many hours
CLEANUP_AGE_HOURS=24

# Cleanup scheduler interval in minutes
CLEANUP_INTERVAL_MINUTES=60

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# ── Logging ──────────────────────────────────────────────────────────────────
# Format: text (human-readable) or json (one JSON object per line for log aggregators)
LOG_FORMAT=json
LOG_LEVEL=INFO
