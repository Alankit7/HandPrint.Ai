# ── Handprint AI — root .env.example ─────────────────────────────────────────
# Copy to .env and fill in real values.
# This file is used by both docker-compose.yml (dev) and docker-compose.prod.yml (prod).

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=54323e3256b14e9e3b873aca59b4d945def5ca57c36a68c50952257b07f21f72

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Storage (paths inside the container / volume mount) ───────────────────────
DATABASE_URL=sqlite:////mnt/data/db/handprint.db
UPLOAD_DIR=/mnt/data/uploads
SAMPLE_DIR=/mnt/data/samples
OUTPUT_DIR=/mnt/data/outputs

# ── File size limits ──────────────────────────────────────────────────────────
MAX_SAMPLE_IMAGE_MB=10
MAX_PDF_MB=50

# ── Sample constraints ────────────────────────────────────────────────────────
MIN_SAMPLE_IMAGES=15
MAX_SAMPLE_IMAGES=30

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_THREADS=2

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_AGE_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow all
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
# text = human-readable; json = one JSON object per line (for log aggregators)
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Flutter app ───────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
