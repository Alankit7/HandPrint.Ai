# ── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Secret key for signing job tokens (change in production)
SECRET_KEY=changeme-use-a-long-random-string

# Directories (relative to backend/)
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
SAMPLE_DIR=data/samples

# Job queue – in-process (simple) or redis
QUEUE_BACKEND=simple
REDIS_URL=redis://localhost:6379/0

# Max PDF upload size in MB
MAX_UPLOAD_MB=50

# ── Handwriting Model ─────────────────────────────────────────────────────────
# Which generator to use: onedm | diffusionpen
HW_MODEL=onedm

# Path to pretrained checkpoint (download separately)
ONEDM_CHECKPOINT=checkpoints/onedm/model.pth
DIFFUSIONPEN_CHECKPOINT=checkpoints/diffusionpen/model.pth

# Number of few-shot reference images used for style conditioning
FEW_SHOT_SAMPLES=8

# Image resolution for the generator (pixels per line height)
IMG_HEIGHT=64

# Device: cuda | cpu
DEVICE=cuda

# ── Flutter / API ─────────────────────────────────────────────────────────────
# Base URL the Flutter app talks to
API_BASE_URL=http://localhost:8000
